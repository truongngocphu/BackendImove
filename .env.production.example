# TH79 iMove Core Backend - PRODUCTION TEMPLATE
# Không copy secret từ file này. Điền secret thật trực tiếp trên VPS.
NODE_ENV=production
HOST=127.0.0.1
PORT=5050
APP_VERSION=1.6.0
CORE_PUBLIC_URL=https://backendimove.daututh79.com

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=th79_imove
MONGO_RETRY_SECONDS=5
DB_REPAIR_ON_START=false

JWT_ACCESS_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_DAYS=30
ADMIN_AUTH_SESSION_HOURS=8
AUTH_DEV_SHOW_OTP=false

# Admin/Web origins. Wildcard chỉ áp dụng cho HTTPS subdomain theo code backend mới.
CORS_ORIGINS=https://imove.daututh79.com,https://*.daututh79.com
FORCE_HTTPS=true
API_RATE_LIMIT_PER_MINUTE=600
LOG_HTTP_SUCCESS=false

# Redis/FCM là optional trừ khi bạn chủ động bật REQUIRED=true.
REDIS_REQUIRED=false
REDIS_URL=
FCM_REQUIRED=false
FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

LAN_DISCOVERY_ENABLED=false
SERVICE_REGISTRY_ENABLED=false
SEED_DEMO_ON_START=false
MATCHING_ALLOW_NO_GPS_FALLBACK=false
TRUST_MATCHING_ENFORCEMENT=true

KYC_DATA_KEY=CHANGE_TO_A_RANDOM_KEY_AT_LEAST_32_CHARS
FACE_PROVIDER_MODE=MANUAL
FACE_EVIDENCE_KEY=CHANGE_TO_A_RANDOM_KEY_AT_LEAST_32_CHARS

DRIVER_PRESENCE_FRESH_MS=90000
DRIVER_PRESENCE_SWEEP_MS=30000
DRIVER_GPS_FRESH_SECONDS=60
BOOKING_SEARCH_TIMEOUT_SECONDS=300
