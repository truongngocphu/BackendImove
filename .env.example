# TH79 iMove Core Backend - DEVELOPMENT TEMPLATE
NODE_ENV=development
HOST=0.0.0.0
PORT=5050
APP_VERSION=1.6.0

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=th79_imove
MONGO_RETRY_SECONDS=5
DB_REPAIR_ON_START=true

JWT_ACCESS_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_DAYS=30
AUTH_OTP_MINUTES=5
AUTH_DEV_SHOW_OTP=false
ADMIN_AUTH_SESSION_HOURS=8

KYC_DATA_KEY=CHANGE_TO_A_RANDOM_KEY_AT_LEAST_32_CHARS
KYC_UPLOAD_DIR=storage/kyc
KYC_MAX_FILE_MB=8
FACE_PROVIDER_MODE=MANUAL
FACE_EVIDENCE_KEY=CHANGE_TO_A_RANDOM_KEY_AT_LEAST_32_CHARS
FACE_MATCH_MIN_SCORE=0.82
FACE_LIVENESS_MIN_SCORE=0.85
DRIVER_FACE_VALID_HOURS=12

BOOKING_SEARCH_TIMEOUT_SECONDS=300
MATCHING_ENABLED=true
MATCHING_OFFER_TIMEOUT_SECONDS=20
MATCHING_SEARCH_RETRY_SECONDS=5
MATCHING_MAX_RADIUS_KM=8
MATCHING_LOCATION_FRESH_SECONDS=45
MATCHING_LOCATION_TTL_SECONDS=120
MATCHING_MAX_CANDIDATES=50
MATCHING_ALLOW_NO_GPS_FALLBACK=false
MATCHING_STRICT_ACCEPT=true

LAN_DISCOVERY_ENABLED=true
LAN_DISCOVERY_PORT=5051
SERVICE_REGISTRY_ENABLED=true
SERVICE_REGISTRY_HEARTBEAT_MS=5000
SERVICE_REGISTRY_TTL_SECONDS=90
CORE_PUBLIC_URL=http://127.0.0.1:5050

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORCE_HTTPS=false
TLS_TERMINATED_BY_PROXY=false
API_RATE_LIMIT_PER_MINUTE=600

REDIS_REQUIRED=false
REDIS_URL=
FCM_REQUIRED=false
FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_MAX_RETRIES=3
FCM_RETRY_SECONDS=3,10,30

TRUST_MATCHING_ENFORCEMENT=true
TRUST_RISK_WINDOW_DAYS=90
TRUST_STEP_UP_THRESHOLD=50
TRUST_REVIEW_THRESHOLD=70
TRUST_RESTRICT_THRESHOLD=85
TRUST_MAX_SPEED_KMH=180
TRUST_OFF_PLATFORM_NEAR_METERS=250
V64_DEMO_TOPUP_ENABLED=false
SEED_DEMO_ON_START=false

MAP_API_RATE_LIMIT_PER_MINUTE=60
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_GEOCODING_URL=https://nominatim.openstreetmap.org
OSM_ROUTING_URL=https://router.project-osrm.org
OSM_USER_AGENT=TH79-iMove/1.6.0 (+https://daututh79.com)
OSM_HTTP_TIMEOUT_MS=7000
OSM_GEOCODE_CACHE_MS=300000
ROUTING_PROFILE_DEFAULT=driving


# TH79 iMove 1.7.1 - OTP SMS delivery
# HTTP provider contract: POST JSON {phone,message,sender,purpose,requestId}
SMS_PROVIDER=NONE
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=TH79 IMOVE
SMS_TIMEOUT_MS=8000
SMS_OTP_TEMPLATE=TH79 iMove: Ma OTP cua ban la {OTP}. Ma co hieu luc {MINUTES} phut. Khong chia se ma nay.
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_PER_HOUR=6

# Fund / QR defaults (Admin can override bank/QR in UI)
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT=
COMPANY_BANK_ACCOUNT_NAME=
COMPANY_BANK_BRANCH=
CUSTOMER_REGISTER_REQUIRE_OTP=true
