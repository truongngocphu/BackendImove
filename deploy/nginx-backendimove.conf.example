# /etc/nginx/sites-available/backendimove.daututh79.com
# Yêu cầu certificate Let's Encrypt đã tồn tại cho backendimove.daututh79.com.

server {
    listen 80;
    listen [::]:80;
    server_name backendimove.daututh79.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name backendimove.daututh79.com;

    ssl_certificate /etc/letsencrypt/live/backendimove.daututh79.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backendimove.daututh79.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TH79SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_verify_client off;

    client_max_body_size 10m;
    proxy_connect_timeout 10s;
    proxy_send_timeout 75s;
    proxy_read_timeout 75s;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;
    }

    location / {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }
}
